{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "refreshWorkspace",
            "input": {}
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/install.js"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/does-not-exist.js"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "Edit(*.java)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChangd",
            "input": { "filePath": "${tool_input.file_path}" }
          },
          {
            "type": "mcp_tool",
            "if": "Edit(*.kt)",
            "server": "spring-tools-mcp",
            "tool": "fileChanged",
            "input": { "path": "${tool_input.file_path}" }
          }
        ]
      }
    ]
  }
}
