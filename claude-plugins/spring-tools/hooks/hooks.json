{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "Write(**/*.{java,kt,kts,groovy,xml,properties,yml,yaml,gradle})",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            }
          }
        ]
      },
      {
        "matcher": "StrReplace",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "StrReplace(**/*.{java,kt,kts,groovy,xml,properties,yml,yaml,gradle})",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            }
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "Edit(**/*.{java,kt,kts,groovy,xml,properties,yml,yaml,gradle})",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            }
          }
        ]
      },
      {
        "matcher": "Replace",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "Replace(**/*.{java,kt,kts,groovy,xml,properties,yml,yaml,gradle})",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            }
          }
        ]
      },
      {
        "matcher": "Delete",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "Delete(**/*.{java,kt,kts,groovy,xml,properties,yml,yaml,gradle})",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileDeleted",
            "input": {
              "filePath": "${tool_input.file_path}"
            }
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "Bash(git *)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "refreshWorkspace",
            "input": {}
          }
        ]
      }
    ]
  }
}
